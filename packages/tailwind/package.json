{
  "name": "@joralvmel/cosmos-tailwind",
  "version": "0.0.0",
  "description": "Tailwind CSS v4 theme for Cosmos UI: utilities mapped to Cosmos tokens, dark and per-theme variants.",
  "keywords": [
    "tailwindcss",
    "tailwind-theme",
    "design-tokens",
    "cosmos-ui"
  ],
  "type": "module",
  "license": "MIT",
  "author": "joralvmel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joralvmel/cosmos-ui.git",
    "directory": "packages/tailwind"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "llms.md"
  ],
  "style": "./dist/index.css",
  "exports": {
    ".": {
      "style": "./dist/index.css",
      "default": "./dist/index.css"
    },
    "./theme.css": "./dist/theme.css",
    "./llms.md": "./llms.md",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@joralvmel/cosmos-tokens": "^0.0.0"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "tailwindcss": "^4.3.5"
  }
}
