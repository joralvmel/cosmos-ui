{
  "name": "@joralvmel/cosmos-angular",
  "version": "0.2.0",
  "description": "Angular standalone components and forms integration for the Cosmos UI Web Components.",
  "keywords": [
    "angular",
    "web-components",
    "design-system",
    "cosmos-ui"
  ],
  "type": "module",
  "license": "MIT",
  "author": "joralvmel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joralvmel/cosmos-ui.git",
    "directory": "packages/angular"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": true,
  "files": [
    "dist",
    "llms.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./llms.md": "./llms.md",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "ngc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@joralvmel/cosmos-core": "^0.2.0",
    "@joralvmel/cosmos-elements": "^0.2.0",
    "@joralvmel/cosmos-icons": "^0.2.0",
    "tslib": "^2.9.1"
  },
  "peerDependencies": {
    "@angular/core": ">=21.0.0",
    "@angular/forms": ">=21.0.0"
  },
  "devDependencies": {
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/compiler-cli": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "rxjs": "^7.8.2"
  }
}
