---
import { type ComponentContract, contracts, supports } from '@joralvmel/cosmos-core';
import { builtInThemes } from '@joralvmel/cosmos-tokens';
import { getStatusReport } from '@joralvmel/cosmos-tools/status';
import { t } from './i18n';

interface Props {
  name: keyof typeof contracts;
  /** Text content of the element. */
  content?: string;
}

const { name, content = '' } = Astro.props;
const contract: ComponentContract = contracts[name];
const s = t(Astro.currentLocale);
// Dynamic custom element tag; typed as a generic element for the Astro checker.
const Element = contract.tag as unknown as 'div';
const fieldActionLabels =
  name === 'text-field'
    ? {
        label: s.playground.textFieldDefaults?.label,
        'clear-label': s.playground.textFieldDefaults?.clearLabel,
        'reveal-password-label': s.playground.textFieldDefaults?.revealPasswordLabel,
        'hide-password-label': s.playground.textFieldDefaults?.hidePasswordLabel,
      }
    : name === 'icon-button'
      ? { label: s.playground.iconButtonLabel }
      : name === 'textarea'
        ? { label: s.playground.textareaLabel }
        : name === 'listbox'
          ? { label: s.playground.listboxLabel }
          : name === 'radio-group'
            ? { label: s.playground.radioGroupLabel }
            : name === 'checkbox'
              ? { label: s.playground.checkboxLabel }
              : name === 'switch'
                ? { label: s.playground.switchLabel }
                : name === 'select'
                  ? {
                      label: s.playground.selectLabel,
                      placeholder: s.playground.selectPlaceholder,
                    }
                  : {};
const web = supports(contract, 'web');
const hasDemo = getStatusReport().components.find(item => item.name === name)?.pieces.nativeDemo;
const nativeDemoUrl = hasDemo
  ? `https://github.com/joralvmel/cosmos-ui/blob/develop/apps/native-demo/app/${name}.tsx`
  : '';
const themes = builtInThemes.map(theme => ({ name: theme.name, label: theme.label }));
---

<div
  class="cosm-playground not-content"
  data-playground
  data-name={name}
  data-content={content}
  data-labels={JSON.stringify(s.playground)}
  data-themes={JSON.stringify(themes)}
  data-native-demo={nativeDemoUrl}
>
  {
    web && (
      <div class="cosm-preview not-content" data-cosm-preview data-theme="cosmos" data-mode="light">
        <Element
          data-playground-target
          {...fieldActionLabels}
        >
          {Object.hasOwn(contract.slots, 'trigger') && <cosm-icon-button {...{ slot: 'trigger' }} label={s.playground.triggerLabel} variant="ghost" tone="neutral"><cosm-icon data-playground-trigger-icon /></cosm-icon-button>}
          {name === 'icon-button'
            ? <cosm-icon data-playground-child />
            : name === 'switch'
              ? null
              : content}
        </Element>
      </div>
    )
  }
  <noscript><p>{s.playground.noScript}</p></noscript>
</div>

<script>
  import '@joralvmel/cosmos-elements';
  import {
    contracts,
    listboxItemExamples,
    listboxValueExamples,
    radioGroupOptionsExamples,
    radioGroupValueExamples,
    selectItemExamples,
    selectValueExamples,
  } from '@joralvmel/cosmos-core';
  import { heart } from '@joralvmel/cosmos-icons/heart';
  import { house } from '@joralvmel/cosmos-icons/house';
  import { info } from '@joralvmel/cosmos-icons/info';
  import { search } from '@joralvmel/cosmos-icons/search';
  import { star } from '@joralvmel/cosmos-icons/star';
  import { initPlayground } from '../lib/playground';

  for (const root of document.querySelectorAll<HTMLElement>('[data-playground]')) {
    const triggerIcon = root.querySelector<HTMLElementTagNameMap['cosm-icon']>(
      '[data-playground-trigger-icon]'
    );
    if (triggerIcon) triggerIcon.icon = info;
    const contract = contracts[root.dataset.name as keyof typeof contracts];
    if (!contract) continue;
    const options = {
      contract,
      content: root.dataset.content ?? '',
      labels: JSON.parse(root.dataset.labels ?? '{}'),
      themes: JSON.parse(root.dataset.themes ?? '[]'),
      nativeDemoUrl: root.dataset.nativeDemo || undefined,
    };
    if (contract.name === 'icon') {
      import('../lib/icon-catalog')
        .then(({ iconReferenceCatalog }) => {
          initPlayground(root, {
            ...options,
            referenceCatalogs: { IconDefinition: iconReferenceCatalog },
          });
        })
        .catch(error => {
          console.error('Could not initialize the icon playground.', error);
          const message = document.createElement('p');
          message.setAttribute('role', 'alert');
          message.textContent = options.labels.iconCatalogError;
          root.append(message);
        });
    } else if (contract.name === 'text-field' || contract.name === 'badge') {
      initPlayground(root, {
        ...options,
        referenceValues: { IconDefinition: { heart, house, search, star } },
      });
    } else if (contract.name === 'listbox') {
      initPlayground(root, {
        ...options,
        referenceValues: {
          ListboxItems: listboxItemExamples,
          ListboxValues: listboxValueExamples,
        },
      });
    } else if (contract.name === 'radio-group') {
      initPlayground(root, {
        ...options,
        referenceValues: {
          RadioGroupOptions: radioGroupOptionsExamples,
          RadioGroupValue: radioGroupValueExamples,
        },
      });
    } else if (contract.name === 'select') {
      initPlayground(root, {
        ...options,
        referenceValues: {
          SelectItems: selectItemExamples,
          SelectValue: selectValueExamples,
        },
      });
    } else if (contract.name === 'icon-button') {
      const icon = root.querySelector<HTMLElementTagNameMap['cosm-icon']>(
        'cosm-icon[data-playground-child]'
      );
      if (icon) icon.icon = heart;
      initPlayground(root, {
        ...options,
        child: { contract: contracts.icon, values: { icon: 'heart' } },
      });
    } else {
      initPlayground(root, options);
    }
  }
</script>
