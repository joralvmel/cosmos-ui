  "create apps/native-demo/app/chip.tsx": "import { Chip, useTheme } from '@joralvmel/cosmos-native';
import { Stack } from 'expo-router';
import { ScrollView, Text } from 'react-native';

export default function ChipScreen() {
  const theme = useTheme();
  const label = { color: theme.colors.fg, fontSize: theme.text.md };
  return (
    <ScrollView contentContainerStyle={{ padding: theme.space.lg, gap: theme.space.lg }}>
      <Stack.Screen options={{ title: 'Chip' }} />
      <Chip>
        <Text style={label}>Chip</Text>
      </Chip>
      <Chip disabled>
        <Text style={label}>Disabled</Text>
      </Chip>
    </ScrollView>
  );
}
",
  "create packages/angular/src/components/chip.component.ts": "import {
  booleanAttribute,
  ChangeDetectionStrategy,
  Component,
  ElementRef,
  Input,
  inject,
} from '@angular/core';
import type { CosmChip } from '@joralvmel/cosmos-elements/chip';
import '@joralvmel/cosmos-elements/chip';

/**
 * Angular proxy of \`<cosm-chip>\`. TODO(generator) add contract inputs and outputs.
 *
 * \`\`\`html
 * <cosm-chip [disabled]="busy">Chip</cosm-chip>
 * \`\`\`
 */
@Component({
  selector: 'cosm-chip',
  template: '<ng-content />',
  changeDetection: ChangeDetectionStrategy.OnPush,
})
export class CosmChipComponent {
  readonly element: CosmChip = inject<ElementRef<CosmChip>>(ElementRef).nativeElement;

  @Input({ transform: booleanAttribute }) set disabled(value: boolean) {
    this.element.disabled = value;
  }
}
",
  "create packages/angular/test/chip.test.ts": "import { Component } from '@angular/core';
import { TestBed } from '@angular/core/testing';
import { chipContract, eventNames, propNames } from '@joralvmel/cosmos-core';
import type { CosmChip } from '@joralvmel/cosmos-elements/chip';
import { afterEach, describe, expect, it } from 'vitest';
import { COSMOS_COMPONENTS, CosmChipComponent } from '../src/index.js';

@Component({
  imports: [CosmChipComponent],
  template: '<cosm-chip disabled>Chip</cosm-chip>',
})
class HostComponent {}

afterEach(() => TestBed.resetTestingModule());

describe('CosmChipComponent', () => {
  it('forwards inputs as element properties', async () => {
    const fixture = TestBed.createComponent(HostComponent);
    await fixture.whenStable();
    const el = fixture.nativeElement.querySelector('cosm-chip') as CosmChip;
    await el.updateComplete;
    expect(el.disabled).toBe(true);
  });

  it('is part of COSMOS_COMPONENTS', () => {
    expect(COSMOS_COMPONENTS).toContain(CosmChipComponent);
  });
});

describe('CosmChipComponent: contract drift', () => {
  it('declares exactly the contract inputs and outputs', () => {
    const def = (CosmChipComponent as unknown as { ɵcmp: { inputs: object; outputs: object } })
      .ɵcmp;
    expect(Object.keys(def.inputs).sort()).toEqual(propNames(chipContract, 'angular').sort());
    expect(Object.keys(def.outputs)).toEqual(eventNames(chipContract, 'angular'));
  });
});
",
  "create packages/core/src/specs/chip.scenarios.ts": "import type { Platform } from '../contract.js';

export interface ChipScenario {
  name: string;
  props: { disabled?: boolean };
  expected: { disabled: boolean };
  platforms?: readonly Platform[];
}

/** Shared behavior scenarios, run by the web, React and native tests. TODO(generator) add behavior. */
export const chipScenarios: readonly ChipScenario[] = [
  { name: 'is enabled by default', props: {}, expected: { disabled: false } },
  { name: 'can be disabled', props: { disabled: true }, expected: { disabled: true } },
];

export const chipScenariosFor = (platform: Platform) =>
  chipScenarios.filter(scenario => !scenario.platforms || scenario.platforms.includes(platform));
",
