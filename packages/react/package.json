{
  "name": "@joralvmel/cosmos-react",
  "version": "0.0.0",
  "description": "React wrappers for the Cosmos UI Web Components (React 19, Vite, Next.js).",
  "keywords": [
    "react",
    "web-components",
    "design-system",
    "cosmos-ui"
  ],
  "type": "module",
  "license": "MIT",
  "author": "joralvmel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joralvmel/cosmos-ui.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": true,
  "files": [
    "dist",
    "llms.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./llms.md": "./llms.md",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@joralvmel/cosmos-core": "^0.0.0",
    "@joralvmel/cosmos-elements": "^0.0.0",
    "@lit/react": "^1.0.8"
  },
  "peerDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
