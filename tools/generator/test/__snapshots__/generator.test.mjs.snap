  "create packages/elements/src/components/chip/cosm-chip.ts": "import { type ContractProps, chipContract } from '@joralvmel/cosmos-core';
import { css, html } from 'lit';
import { CosmElement } from '../../internal/cosm-element.js';
import { define } from '../../internal/define.js';
import { boxSizing } from '../../internal/styles.js';

type Props = Required<ContractProps<typeof chipContract, 'web'>>;

const styles = css\`
  :host {
    display: inline-block;
    color: var(--cosm-fg, oklch(0.24 0.01 268));
    font-family: var(--cosm-font-sans, system-ui, sans-serif);
  }
  :host([disabled]) {
    opacity: 0.5;
  }
\`;

/**
 * TODO(generator): describe the component.
 *
 * @tag cosm-chip
 * @slot - Content.
 * @csspart base - Root element.
 */
export class CosmChip extends CosmElement {
  static override properties = {
    disabled: { type: Boolean, reflect: true },
  };

  static override styles = [boxSizing, styles];

  declare disabled: Props['disabled'];

  constructor() {
    super();
    this.disabled = chipContract.props.disabled.default;
  }

  protected override render() {
    return html\`<div part="base" class="base" aria-disabled=\${this.disabled ? 'true' : 'false'}>
      <slot></slot>
    </div>\`;
  }
}

define('cosm-chip', CosmChip);

declare global {
  interface HTMLElementTagNameMap {
    'cosm-chip': CosmChip;
  }
}
",
  "create packages/elements/test/chip.test.ts": "import { chipContract, chipScenariosFor, eventNames, propNames } from '@joralvmel/cosmos-core';
import { afterEach, describe, expect, it, vi } from 'vitest';
import { CosmChip } from '../src/components/chip/cosm-chip.js';
import { cleanup, fixture } from './fixture.js';

afterEach(cleanup);

describe('cosm-chip: shared scenarios', () => {
  for (const scenario of chipScenariosFor('web')) {
    it(scenario.name, async () => {
      const el = await fixture<CosmChip>('<cosm-chip>Content</cosm-chip>');
      Object.assign(el, scenario.props);
      await el.updateComplete;
      const base = el.shadowRoot?.querySelector('[part="base"]');
      expect(base?.getAttribute('aria-disabled')).toBe(String(scenario.expected.disabled));
    });
  }
});

describe('cosm-chip: contract drift', () => {
  it('exposes exactly the web props of the contract', () => {
    expect(Object.keys(CosmChip.properties).sort()).toEqual(
      propNames(chipContract, 'web').sort()
    );
  });

  it('dispatches only the DOM events of the contract', async () => {
    const el = await fixture<CosmChip>('<cosm-chip>Content</cosm-chip>');
    const listener = vi.fn();
    for (const name of eventNames(chipContract, 'dom')) el.addEventListener(name, listener);
    expect(eventNames(chipContract, 'dom').every(name => name.startsWith('cosm-'))).toBe(true);
  });
});

describe('cosm-chip', () => {
  it('reflects styling props', async () => {
    const el = await fixture<CosmChip>('<cosm-chip disabled>Content</cosm-chip>');
    expect(el.hasAttribute('disabled')).toBe(true);
  });
});
",
  "create packages/native/src/components/chip.tsx": "import { type ContractProps, chipContract } from '@joralvmel/cosmos-core';
import type { ReactNode } from 'react';
import { type StyleProp, Text, View, type ViewStyle } from 'react-native';
import { useTheme } from '../theme/theme-provider.js';

type ContractChipProps = ContractProps<typeof chipContract, 'native'>;

export interface ChipProps extends ContractChipProps {
  children?: ReactNode;
  style?: StyleProp<ViewStyle>;
  testID?: string;
}

/** Props handled by the native component; checked against the contract by the drift test. */
export const chipPropNames = ['disabled'] as const satisfies readonly (keyof ContractChipProps)[];

/** Native Chip. TODO(generator) implement the contract behavior. */
export function Chip({
  disabled = chipContract.props.disabled.default,
  children,
  style,
  testID,
}: ChipProps) {
  const theme = useTheme();
  return (
    <View
      testID={testID}
      accessibilityState={{ disabled }}
      style={[{ opacity: disabled ? 0.5 : 1 }, style]}
    >
      {typeof children === 'string' ? (
        <Text style={{ color: theme.colors.fg, fontSize: theme.text.md }}>{children}</Text>
      ) : (
        children
      )}
    </View>
  );
}
",
  "create packages/native/test/chip.test.tsx": "import { chipContract, chipScenariosFor, propNames } from '@joralvmel/cosmos-core';
import { act, type ReactNode } from 'react';
import { createRoot, type Root } from 'react-dom/client';
import { afterEach, describe, expect, it } from 'vitest';
import { Chip, chipPropNames } from '../src/index.js';

Object.assign(globalThis, { IS_REACT_ACT_ENVIRONMENT: true });

let root: Root | undefined;
let container: HTMLElement | undefined;

async function render(node: ReactNode) {
  container = document.createElement('div');
  document.body.append(container);
  root = createRoot(container);
  await act(async () => root?.render(node));
  return container.querySelector('[data-testid="subject"]');
}

afterEach(async () => {
  await act(async () => root?.unmount());
  container?.remove();
});

describe('Chip (native): shared scenarios', () => {
  for (const scenario of chipScenariosFor('native')) {
    it(scenario.name, async () => {
      const subject = await render(
        <Chip {...scenario.props} testID="subject">
          Chip
        </Chip>
      );
      expect(subject?.getAttribute('aria-disabled') === 'true').toBe(scenario.expected.disabled);
    });
  }
});

describe('Chip (native): contract drift', () => {
  it('handles exactly the native props of the contract', () => {
    expect([...chipPropNames].sort()).toEqual(propNames(chipContract, 'native').sort());
  });
});
",
  "create packages/react/src/components/chip.ts": "import { CosmChip } from '@joralvmel/cosmos-elements/chip';
import { createComponent } from '@lit/react';
import * as React from 'react';

/** React event props of \`Chip\`, mapped to DOM events. TODO(generator) add contract events. */
export const chipEvents = {};

/** React wrapper of \`<cosm-chip>\`. */
export const Chip = createComponent({
  tagName: 'cosm-chip',
  elementClass: CosmChip,
  react: React,
  events: chipEvents,
  displayName: 'Chip',
});

export type ChipProps = React.ComponentProps<typeof Chip>;
",
  "create packages/react/test/chip.test.tsx": "import { chipContract, chipScenariosFor, eventNames, propNames } from '@joralvmel/cosmos-core';
import type { CosmChip } from '@joralvmel/cosmos-elements/chip';
import { act } from 'react';
import { createRoot, type Root } from 'react-dom/client';
import { afterEach, describe, expect, it } from 'vitest';
import { Chip, type ChipProps, chipEvents } from '../src/index.js';

Object.assign(globalThis, { IS_REACT_ACT_ENVIRONMENT: true });

let root: Root | undefined;
let container: HTMLElement | undefined;

async function render(props: ChipProps) {
  container = document.createElement('div');
  document.body.append(container);
  root = createRoot(container);
  await act(async () => root?.render(<Chip {...props}>Chip</Chip>));
  const el = container.querySelector('cosm-chip') as CosmChip;
  await el.updateComplete;
  return el;
}

afterEach(async () => {
  await act(async () => root?.unmount());
  container?.remove();
});

describe('Chip: shared scenarios', () => {
  for (const scenario of chipScenariosFor('react')) {
    it(scenario.name, async () => {
      const el = await render(scenario.props);
      expect(el.disabled).toBe(scenario.expected.disabled);
    });
  }
});

describe('Chip: contract drift', () => {
  it('maps every contract event to its React name', () => {
    expect(Object.keys(chipEvents)).toEqual(eventNames(chipContract, 'react'));
  });

  it('forwards every contract prop to the element', async () => {
    const el = await render({});
    for (const name of propNames(chipContract, 'react')) expect(name in el, name).toBe(true);
  });
});
",
