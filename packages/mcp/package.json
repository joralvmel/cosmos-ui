{
  "name": "@joralvmel/cosmos-mcp",
  "version": "0.1.1",
  "description": "Model Context Protocol server exposing Cosmos UI components, snippets, status, themes, tokens, setup guides and docs to AI assistants.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "llm",
    "cosmos-ui"
  ],
  "type": "module",
  "license": "MIT",
  "author": "joralvmel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joralvmel/cosmos-ui.git",
    "directory": "packages/mcp"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "llms.md"
  ],
  "bin": {
    "cosmos-mcp": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./llms.md": "./llms.md",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-data.mjs",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@joralvmel/cosmos-core": "^0.2.0",
    "@joralvmel/cosmos-tokens": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@joralvmel/cosmos-tools": "^0.0.0"
  }
}
