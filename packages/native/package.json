{
  "name": "@joralvmel/cosmos-native",
  "version": "0.2.0",
  "description": "Cosmos UI components for React Native and Expo, sharing contracts and themes with the web components.",
  "keywords": [
    "react-native",
    "expo",
    "design-system",
    "cosmos-ui"
  ],
  "type": "module",
  "license": "MIT",
  "author": "joralvmel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joralvmel/cosmos-ui.git",
    "directory": "packages/native"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "llms.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./llms.md": "./llms.md",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@joralvmel/cosmos-core": "^0.2.0",
    "@joralvmel/cosmos-icons": "^0.2.0",
    "@joralvmel/cosmos-tokens": "^0.1.0",
    "react-native-svg": "15.16.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-native": ">=0.80.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1"
  }
}
