---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { t } from './i18n';

/** Page title plus "Copy page for AI" and "View as Markdown" (the `.md` version of the page). */
const s = t(Astro.currentLocale);
const path = Astro.url.pathname.replace(/\/$/, '');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const markdownUrl = path === base || path === '' ? `${base}/index.md` : `${path}.md`;
---

<Default />
<div class="cosm-page-ai not-content">
  <button type="button" data-copy-page={markdownUrl} data-copied={s.ai.copied} data-failed={s.ai.failed}>
    {s.ai.copy}
  </button>
  <a href={markdownUrl}>{s.ai.markdown}</a>
  <span role="status" class="cosm-page-ai-status"></span>
</div>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-page]')) {
    const status = button.parentElement?.querySelector('[role="status"]');
    button.addEventListener('click', async () => {
      try {
        const response = await fetch(button.dataset.copyPage ?? '');
        if (!response.ok) throw new Error(String(response.status));
        await navigator.clipboard.writeText(await response.text());
        if (status) status.textContent = button.dataset.copied ?? '';
      } catch {
        if (status) status.textContent = button.dataset.failed ?? '';
      }
    });
  }
</script>

<style>
  .cosm-page-ai {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
    font-size: var(--sl-text-sm);
  }
  button {
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.375rem;
    background: transparent;
    color: var(--sl-color-gray-1);
    font: inherit;
    cursor: pointer;
  }
  button:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  .cosm-page-ai-status {
    color: var(--sl-color-gray-3);
  }
</style>
