---
import { type ComponentContract, contracts, supports } from '@joralvmel/cosmos-core';
import { builtInThemes } from '@joralvmel/cosmos-tokens';
import { getStatusReport } from '@joralvmel/cosmos-tools/status';
import { t } from './i18n';

interface Props {
  name: keyof typeof contracts;
  /** Text content of the element. */
  content?: string;
}

const { name, content = '' } = Astro.props;
const contract: ComponentContract = contracts[name];
const s = t(Astro.currentLocale);
// Dynamic custom element tag; typed as a generic element for the Astro checker.
const Element = contract.tag as unknown as 'div';
const web = supports(contract, 'web');
const hasDemo = getStatusReport().components.find(item => item.name === name)?.pieces.nativeDemo;
const nativeDemoUrl = hasDemo
  ? `https://github.com/joralvmel/cosmos-ui/blob/develop/apps/native-demo/app/${name}.tsx`
  : '';
const themes = builtInThemes.map(theme => ({ name: theme.name, label: theme.label }));
---

<div
  class="cosm-playground"
  data-playground
  data-name={name}
  data-content={content}
  data-labels={JSON.stringify(s.playground)}
  data-themes={JSON.stringify(themes)}
  data-native-demo={nativeDemoUrl}
>
  {
    web && (
      <div class="cosm-preview not-content" data-cosm-preview data-theme="cosmos" data-mode="light">
        <Element data-playground-target>{content}</Element>
      </div>
    )
  }
  <noscript><p>{s.playground.noScript}</p></noscript>
</div>

<script>
  import '@joralvmel/cosmos-elements';
  import { contracts } from '@joralvmel/cosmos-core';
  import { initPlayground } from '../lib/playground';

  for (const root of document.querySelectorAll<HTMLElement>('[data-playground]')) {
    const contract = contracts[root.dataset.name as keyof typeof contracts];
    if (!contract) continue;
    const options = {
      contract,
      content: root.dataset.content ?? '',
      labels: JSON.parse(root.dataset.labels ?? '{}'),
      themes: JSON.parse(root.dataset.themes ?? '[]'),
      nativeDemoUrl: root.dataset.nativeDemo || undefined,
    };
    if (contract.name === 'icon') {
      import('../lib/icon-catalog')
        .then(({ iconReferenceCatalog }) => {
          initPlayground(root, {
            ...options,
            referenceCatalogs: { IconDefinition: iconReferenceCatalog },
          });
        })
        .catch(error => {
          console.error('Could not initialize the icon playground.', error);
          const message = document.createElement('p');
          message.setAttribute('role', 'alert');
          message.textContent = options.labels.iconCatalogError;
          root.append(message);
        });
    } else {
      initPlayground(root, options);
    }
  }
</script>
