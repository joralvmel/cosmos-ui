/**
 * Chip: TODO(generator) describe the component and link its WAI-ARIA pattern.
 */
export const chipContract = defineContract({
  name: 'chip',
  tag: 'cosm-chip',
  description: 'TODO(generator): one-line description.',
  role: 'TODO(generator)',
  pattern: 'https://www.w3.org/WAI/ARIA/apg/patterns/',
  props: {
    disabled: {
      type: 'boolean',
      default: false,
      reflect: true,
      description: 'Prevents interaction.',
    },
  },
  events: {},
  states: [],
  slots: { '': 'Content.' },
  parts: { base: 'Root element.' },
  cssProperties: {},
  keyboard: [],
});
