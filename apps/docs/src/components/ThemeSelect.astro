---
import Default from '@astrojs/starlight/components/ThemeSelect.astro';
import { builtInThemes } from '@joralvmel/cosmos-tokens';
import { t } from './i18n';

const s = t(Astro.currentLocale);
---

<div class="cosm-theme-select">
  <label>
    <span class="sr-only">{s.theme}</span>
    <select data-cosm-theme-select aria-label={s.theme}>
      {builtInThemes.map(theme => <option value={theme.name}>{theme.label}</option>)}
    </select>
  </label>
  <Default />
</div>

<script>
  import { applySiteTheme, SITE_THEME_KEY } from '../lib/theme';

  const html = document.documentElement;
  for (const select of document.querySelectorAll<HTMLSelectElement>('[data-cosm-theme-select]')) {
    select.addEventListener('change', () => {
      localStorage.setItem(SITE_THEME_KEY, select.value);
      applySiteTheme();
    });
  }
  new MutationObserver(() => applySiteTheme()).observe(html, {
    attributes: true,
    attributeFilter: ['data-theme'],
  });
  applySiteTheme();
</script>

<style>
  .cosm-theme-select {
    display: flex;
    gap: 1rem;
    align-items: center;
  }
  select {
    background: transparent;
    color: var(--sl-color-gray-1);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.25rem;
    padding: 0.25rem 0.5rem;
    font-size: var(--sl-text-sm);
  }
</style>
