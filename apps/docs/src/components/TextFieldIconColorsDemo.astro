---
import { SELECT_NONE_VALUE } from '../lib/select-control';
import { t } from './i18n';

const s = t(Astro.currentLocale).textFieldIcons;
const hooks = [
  ['start-icon-color', s.start],
  ['end-icon-color', s.end],
  ['start-icon-focus-color', s.startFocus],
  ['end-icon-focus-color', s.endFocus],
];
const colors = [
  ['primary', s.primary],
  ['success', s.success],
  ['danger', s.danger],
  ['warning', s.warning],
];
---

<div
  class="icon-colors-demo not-content"
  data-icon-colors-demo
  data-cosm-preview
  data-theme="cosmos"
  data-mode="light"
>
  <div class="color-controls">
    {
      hooks.map(([hook, label]) => (
        <div
          data-icon-color={hook}
          data-label={label}
          data-placeholder={s.fallback}
          data-items={JSON.stringify(
            [
              { value: SELECT_NONE_VALUE, label: s.fallback },
              ...colors.map(([token, name]) => ({
                value: `var(--cosm-${token}-text)`,
                label: name,
              })),
            ]
          )}
        />
      ))
    }
    <div
      data-icon-focus-scope
      data-label={s.scope}
      data-placeholder={s.control}
      data-items={JSON.stringify([
        { value: 'control', label: s.control },
        { value: 'input', label: s.input },
      ])}
    />
  </div>
  <cosm-text-field
    label={s.label}
    type="password"
    value="sample"
    clearable
    clear-label={s.clear}
    password-reveal
    reveal-password-label={s.show}
    hide-password-label={s.hide}
  ></cosm-text-field>
</div>

<script>
  import '@joralvmel/cosmos-elements/text-field';
  import '@joralvmel/cosmos-elements/select';
  import type { CosmSelect } from '@joralvmel/cosmos-elements/select';
  import { heart } from '@joralvmel/cosmos-icons/heart';
  import { search } from '@joralvmel/cosmos-icons/search';
  import { normalizeSelectValue } from '../lib/select-control';

  for (const root of document.querySelectorAll<HTMLElement>('[data-icon-colors-demo]')) {
    const field = root.querySelector('cosm-text-field');
    if (!field) throw new Error('Icon color demo requires a text field.');
    field.startIcon = search;
    field.endIcon = heart;
    const createSelect = (placeholder: HTMLElement) => {
      const control = document.createElement('cosm-select') as CosmSelect;
      control.label = placeholder.dataset.label ?? '';
      control.placeholder = placeholder.dataset.placeholder ?? '';
      control.items = JSON.parse(placeholder.dataset.items ?? '[]');
      if (placeholder.dataset.iconColor !== undefined)
        control.dataset.iconColor = placeholder.dataset.iconColor;
      if (placeholder.hasAttribute('data-icon-focus-scope')) {
        control.dataset.iconFocusScope = '';
        control.value = 'control';
      } else {
        control.value = null;
      }
      placeholder.replaceWith(control);
      return control;
    };
    for (const placeholder of root.querySelectorAll<HTMLElement>('[data-icon-color]')) {
      const control = createSelect(placeholder);
      control.addEventListener('cosm-change', event => {
        const value = normalizeSelectValue(
          (event as CustomEvent<{ value: string | null }>).detail.value
        );
        control.value = value;
        const property = `--cosm-text-field-${control.dataset.iconColor}`;
        if (value) field.style.setProperty(property, value);
        else field.style.removeProperty(property);
      });
    }
    const focusScopePlaceholder = root.querySelector<HTMLElement>('[data-icon-focus-scope]');
    if (!focusScopePlaceholder)
      throw new Error('Icon color demo requires a focus-scope selector.');
    const focusScope = createSelect(focusScopePlaceholder);
    focusScope.value = 'control';
    focusScope.addEventListener(
      'cosm-change',
      event => {
        const value = normalizeSelectValue(
          (event as CustomEvent<{ value: string | null }>).detail.value
        );
        if (value !== 'control' && value !== 'input')
          throw new TypeError('Unknown icon focus scope.');
        focusScope.value = value;
        field.iconFocusScope = value;
      }
    );
  }
</script>

<style>
  .icon-colors-demo {
    display: grid;
    gap: var(--cosm-space-lg);
    padding: var(--cosm-space-lg);
    border: 1px solid var(--cosm-border);
    border-radius: var(--cosm-radius-md);
  }
  .color-controls {
    display: flex;
    flex-wrap: wrap;
    gap: var(--cosm-space-md);
  }
  .color-controls cosm-select {
    flex: 1 1 12rem;
    min-inline-size: min(100%, 12rem);
  }
</style>
