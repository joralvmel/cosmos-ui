{
  "name": "@joralvmel/cosmos-charts-native",
  "version": "0.1.0",
  "description": "Cosmos UI charts for React Native, built on the shared chart layout.",
  "keywords": [
    "charts",
    "react-native",
    "svg",
    "cosmos-ui"
  ],
  "type": "module",
  "license": "MIT",
  "author": "joralvmel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joralvmel/cosmos-ui.git",
    "directory": "packages/charts-native"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "llms.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./llms.md": "./llms.md",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@joralvmel/cosmos-charts-core": "^0.1.0",
    "@joralvmel/cosmos-tokens": "^0.1.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-native": ">=0.80.0",
    "react-native-svg": ">=15.0.0"
  },
  "peerDependenciesMeta": {
    "react-native-svg": {
      "optional": true
    }
  }
}
