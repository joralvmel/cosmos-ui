{
  "name": "@joralvmel/cosmos-elements",
  "version": "0.2.0",
  "description": "Cosmos UI Web Components built with Lit: framework-agnostic, themeable and accessible.",
  "keywords": [
    "web-components",
    "custom-elements",
    "lit",
    "design-system",
    "cosmos-ui"
  ],
  "type": "module",
  "license": "MIT",
  "author": "joralvmel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joralvmel/cosmos-ui.git",
    "directory": "packages/elements"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "./dist/components/**/*.js",
    "./dist/index.js"
  ],
  "files": [
    "dist",
    "llms.md"
  ],
  "customElements": "dist/custom-elements.json",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/components/button/cosm-button.d.ts",
      "default": "./dist/components/button/cosm-button.js"
    },
    "./icon": {
      "types": "./dist/components/icon/cosm-icon.d.ts",
      "default": "./dist/components/icon/cosm-icon.js"
    },
    "./custom-elements.json": "./dist/custom-elements.json",
    "./llms.md": "./llms.md",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cem analyze",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@joralvmel/cosmos-core": "^0.2.0",
    "@joralvmel/cosmos-icons": "^0.2.0",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0"
  }
}
