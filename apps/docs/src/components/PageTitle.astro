---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { t } from './i18n';

/** Page title plus "Copy page for AI" and "View as Markdown" (the `.md` version of the page). */
const s = t(Astro.currentLocale);
const path = Astro.url.pathname.replace(/\/$/, '');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const markdownUrl = path === base || path === '' ? `${base}/index.md` : `${path}.md`;
---

<Default />
<div class="cosm-page-ai not-content">
  <cosm-button
    type="button"
    variant="outline"
    tone="neutral"
    size="sm"
    class="cosm-docs-action-button cosm-page-ai-button"
    data-copy-page={markdownUrl}
    data-copied={s.ai.copied}
    data-failed={s.ai.failed}
  >
    {s.ai.copy}
  </cosm-button>
  <a href={markdownUrl}>{s.ai.markdown}</a>
  <span role="status" class="cosm-page-ai-status"></span>
</div>

<script>
  import '@joralvmel/cosmos-elements/button';
  import type { CosmButton } from '@joralvmel/cosmos-elements/button';

  for (const button of document.querySelectorAll<CosmButton>('[data-copy-page]')) {
    const status = button.parentElement?.querySelector('[role="status"]');
    button.addEventListener('cosm-press', async () => {
      try {
        const response = await fetch(button.dataset.copyPage ?? '');
        if (!response.ok) throw new Error(String(response.status));
        await navigator.clipboard.writeText(await response.text());
        if (status) status.textContent = button.dataset.copied ?? '';
      } catch {
        if (status) status.textContent = button.dataset.failed ?? '';
      }
    });
  }
</script>

<style>
  .cosm-page-ai {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
    font-size: var(--sl-text-sm);
  }
  .cosm-page-ai-button {
    --cosm-fg: var(--sl-color-gray-1);
    --cosm-bg: var(--sl-color-bg);
    --cosm-neutral-3: var(--sl-color-gray-6);
    --cosm-border-strong: var(--sl-color-gray-4);
    --cosm-focus-ring: var(--sl-color-accent);
    --cosm-text-sm: var(--sl-text-sm);
    --cosm-font-sans: var(--sl-font-system, system-ui, sans-serif);
  }
  .cosm-page-ai-status {
    color: var(--sl-color-gray-3);
  }
</style>
